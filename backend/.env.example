# MongoDB connection string. Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/task-manager?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long, random string in production
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-long-random-secret

# JWT expiry, e.g. 7d, 12h, 3600 (seconds)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Port the API listens on (optional, defaults to 3000)
PORT=3000
