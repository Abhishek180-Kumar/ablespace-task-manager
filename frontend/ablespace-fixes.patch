diff --git a/frontend/app/profile/page.tsx b/frontend/app/profile/page.tsx
new file mode 100644
index 0000000..2a4517d
--- /dev/null
+++ b/frontend/app/profile/page.tsx
@@ -0,0 +1,198 @@
+'use client';
+
+import { useState, useEffect } from 'react';
+import AuthGuard from '@/components/AuthGuard';
+import AppShell from '@/components/AppShell';
+import { api, User } from '@/lib/api';
+import { useAuth } from '@/lib/auth';
+
+export default function ProfilePage() {
+  const { user: authUser, updateUser } = useAuth();
+  const [user, setUser] = useState<User | null>(null);
+  const [name, setName] = useState('');
+  const [email, setEmail] = useState('');
+  const [profileSaving, setProfileSaving] = useState(false);
+  const [profileError, setProfileError] = useState('');
+  const [profileSuccess, setProfileSuccess] = useState('');
+
+  const [currentPassword, setCurrentPassword] = useState('');
+  const [newPassword, setNewPassword] = useState('');
+  const [passwordSaving, setPasswordSaving] = useState(false);
+  const [passwordError, setPasswordError] = useState('');
+  const [passwordSuccess, setPasswordSuccess] = useState('');
+
+  useEffect(() => {
+    const load = async () => {
+      try {
+        const data = await api.users.getMe();
+        setUser(data);
+        setName(data.name || '');
+        setEmail(data.email || '');
+      } catch (err) {
+        setProfileError(err instanceof Error ? err.message : 'Failed to load profile');
+      }
+    };
+    load();
+  }, []);
+
+  const handleProfileSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setProfileError('');
+    setProfileSuccess('');
+    setProfileSaving(true);
+    try {
+      const updated = await api.users.updateProfile({ name, email });
+      setUser(updated);
+      updateUser(updated);
+      setProfileSuccess('Profile updated.');
+    } catch (err) {
+      setProfileError(err instanceof Error ? err.message : 'Failed to update profile');
+    } finally {
+      setProfileSaving(false);
+    }
+  };
+
+  const handlePasswordSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setPasswordError('');
+    setPasswordSuccess('');
+    setPasswordSaving(true);
+    try {
+      await api.users.changePassword({ currentPassword, newPassword });
+      setPasswordSuccess('Password changed.');
+      setCurrentPassword('');
+      setNewPassword('');
+    } catch (err) {
+      setPasswordError(err instanceof Error ? err.message : 'Failed to change password');
+    } finally {
+      setPasswordSaving(false);
+    }
+  };
+
+  const isGuest = user?.isGuest ?? authUser?.isGuest;
+
+  return (
+    <AuthGuard>
+      <AppShell>
+        <div className="max-w-xl">
+          <h1 className="text-2xl font-bold text-gray-900 dark:text-white mb-6">Profile</h1>
+
+          {isGuest && (
+            <div className="mb-6 bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded text-sm dark:bg-yellow-900/30 dark:border-yellow-800 dark:text-yellow-200">
+              You&apos;re signed in as a guest. Profile and password changes aren&apos;t available for guest accounts.
+            </div>
+          )}
+
+          <form onSubmit={handleProfileSubmit} className="space-y-4 mb-10">
+            <h2 className="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide">
+              Account details
+            </h2>
+
+            {profileError && (
+              <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm dark:bg-red-900 dark:border-red-700 dark:text-red-200" role="alert">
+                {profileError}
+              </div>
+            )}
+            {profileSuccess && (
+              <div className="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded text-sm dark:bg-green-900 dark:border-green-700 dark:text-green-200" role="status">
+                {profileSuccess}
+              </div>
+            )}
+
+            <div>
+              <label htmlFor="profile-name" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
+                Name
+              </label>
+              <input
+                id="profile-name"
+                type="text"
+                value={name}
+                disabled={isGuest}
+                onChange={(e) => setName(e.target.value)}
+                className="w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white disabled:opacity-60"
+              />
+            </div>
+
+            <div>
+              <label htmlFor="profile-email" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
+                Email
+              </label>
+              <input
+                id="profile-email"
+                type="email"
+                value={email}
+                disabled={isGuest}
+                onChange={(e) => setEmail(e.target.value)}
+                className="w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white disabled:opacity-60"
+              />
+            </div>
+
+            <button
+              type="submit"
+              disabled={isGuest || profileSaving}
+              className="px-4 py-2 text-sm font-medium text-white bg-accent bg-accent-hover rounded-md disabled:opacity-50"
+            >
+              {profileSaving ? 'Saving...' : 'Save changes'}
+            </button>
+          </form>
+
+          <form onSubmit={handlePasswordSubmit} className="space-y-4">
+            <h2 className="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide">
+              Change password
+            </h2>
+
+            {passwordError && (
+              <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm dark:bg-red-900 dark:border-red-700 dark:text-red-200" role="alert">
+                {passwordError}
+              </div>
+            )}
+            {passwordSuccess && (
+              <div className="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded text-sm dark:bg-green-900 dark:border-green-700 dark:text-green-200" role="status">
+                {passwordSuccess}
+              </div>
+            )}
+
+            <div>
+              <label htmlFor="current-password" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
+                Current password
+              </label>
+              <input
+                id="current-password"
+                type="password"
+                value={currentPassword}
+                disabled={isGuest}
+                onChange={(e) => setCurrentPassword(e.target.value)}
+                className="w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white disabled:opacity-60"
+                autoComplete="current-password"
+              />
+            </div>
+
+            <div>
+              <label htmlFor="new-password" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
+                New password
+              </label>
+              <input
+                id="new-password"
+                type="password"
+                value={newPassword}
+                disabled={isGuest}
+                onChange={(e) => setNewPassword(e.target.value)}
+                className="w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white disabled:opacity-60"
+                autoComplete="new-password"
+                minLength={6}
+              />
+            </div>
+
+            <button
+              type="submit"
+              disabled={isGuest || passwordSaving}
+              className="px-4 py-2 text-sm font-medium text-white bg-accent bg-accent-hover rounded-md disabled:opacity-50"
+            >
+              {passwordSaving ? 'Saving...' : 'Change password'}
+            </button>
+          </form>
+        </div>
+      </AppShell>
+    </AuthGuard>
+  );
+}
